    <!-- 게임 종료/승리 모달 -->
    <div id="game-modal" class="modal">
        <div class="modal-content">
            <h2 id="modal-title" class="text-3xl font-bold mb-4 text-indigo-400"></h2>
            <div id="modal-content" class="text-gray-300"></div>
            <p id="final-stats" class="text-xl mt-4"></p>
            <div id="gemini-analysis-area" class="mt-8">
