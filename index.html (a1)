            <button id="how-to-play-tab" class="tab-button px-6 py-3 rounded-t-xl text-lg hover:bg-gray-700">게임 방법</button>
        </div>
        <div id="content-display" class="p-6 bg-[#1f2937] rounded-b-xl border border-gray-700 max-h-[600px] overflow-y-auto scrollbar-thin scrollbar-thumb-gray-500 scrollbar-track-gray-800">
            <!-- 탭 내용이 여기에 동적으로 로드됩니다 -->
        </div>
        <div class="flex justify-center mt-6">
            <button id="back-to-main-button" class="px-6 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition-colors text-white font-bold">메인 게임으로 돌아가기</button>
        </div>
