<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hit and Blow game(number baseball, Cows and Bulls, mastermind) by macu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/tone@14.7.58/build/Tone.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1f2937, #111827);
            color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            width: 100%;
            background-color: #1f2937;
            border-radius: 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            padding: 3rem;
            border: 2px solid #374151;
            transition: all 0.5s ease-in-out;
            animation: fadeIn 0.8s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .rainbow-text {
            background-image: linear-gradient(to right, #ef4444, #f97316, #fde047, #22c55e, #0ea5e9, #6366f1, #a855f7, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
        }
        .color-cell, .number-cell {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            border: 2px solid #4b5563;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s, background-color 0.3s;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.25rem;
            font-weight: bold;
        }
        .current-guess-cell {
            border: 3px solid #6b7280;
            cursor: pointer;
        }
        .current-guess-cell.active {
            border-color: #60a5fa;
            box-shadow: 0 0 15px rgba(96, 165, 250, 0.5);
        }
        .color-cell:hover, .number-cell:hover, .selector-cell:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }
        .feedback-peg {
            width: 0.75rem;
            height: 0.75rem;
            border-radius: 9999px;
        }
        .hit { background-color: #ef4444; }
        .blow { background-color: #22c55e; }
        .miss { background-color: #6b7280; }
        .selector-cell {
            width: 3rem;
            height: 3rem;
            border-radius: 9999px;
            border: 3px solid transparent;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s, background-color 0.3s;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            font-weight: bold;
        }
        .selector-cell.active {
            border-color: #60a5fa;
            transform: scale(1.1);
        }
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            backdrop-filter: blur(5px);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }
        .modal.open {
            opacity: 1;
            visibility: visible;
        }
        .modal-content {
            background-color: #1f2937;
            padding: 2.5rem;
            border-radius: 1.5rem;
            border: 2px solid #374151;
            max-width: 500px;
            width: 90%;
            text-align: center;
            transform: translateY(-20px);
            transition: transform 0.3s;
        }
        .modal.open .modal-content {
            transform: translateY(0);
        }
        .hint-box, .analysis-box {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 1rem;
            border-radius: 0.75rem;
            min-height: 4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            margin-top: 1rem;
            font-style: italic;
        }
        .win-glow {
            box-shadow: 0 0 40px 10px rgba(96, 165, 250, 0.7);
            animation: pulse-glow 2s infinite alternate;
        }
        @keyframes pulse-glow {
            from { box-shadow: 0 0 40px 10px rgba(96, 165, 250, 0.7); }
            to { box-shadow: 0 0 60px 15px rgba(96, 165, 250, 1); }
        }
        .lose-shake {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
            transform: translate3d(0, 0, 0);
            backface-visibility: hidden;
            perspective: 1000px;
        }
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }
        .scrollbar-thin::-webkit-scrollbar {
            width: 8px;
        }
        .scrollbar-thin::-webkit-scrollbar-track {
            background: #2d3748;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb {
            background-color: #6b7280;
            border-radius: 20px;
            border: 2px solid #2d3748;
        }
        .tab-button {
            background-color: #374151;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
        }
        .tab-button.active {
            background-color: #1f2937;
            border-bottom: 2px solid #60a5fa;
            font-weight: bold;
        }
        .pause-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(31, 41, 55, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            font-weight: bold;
            color: #60a5fa;
            border-radius: 1.5rem;
            z-index: 50;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-100">

    <!-- 로그인 / 회원가입 모달 -->
