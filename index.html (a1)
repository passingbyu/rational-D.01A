    <!-- 미니게임 / 통계 / 크레딧 페이지 컨테이너 -->
    <div id="additional-content-container" class="container hidden">
        <div class="flex justify-center mb-6">
            <button id="stats-tab" class="tab-button active px-6 py-3 rounded-t-xl text-lg hover:bg-gray-700">게임 통계</button>
            <button id="minigame-tab" class="tab-button px-6 py-3 rounded-t-xl text-lg hover:bg-gray-700">미니게임</button>
