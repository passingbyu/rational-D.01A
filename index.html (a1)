    <script>
        // Game state variables
        const COLORS = ["#ef4444", "#f97316", "#fde047", "#22c55e", "#0ea5e9", "#6366f1", "#a855f7", "#ec4899", "#84cc16", "#eab308", "#f43f5e", "#14b8a6", "#3b82f6", "#be123c", "#fca5a5", "#a78bfa"];
        const NUMBERS = Array.from({ length: 16 }, (_, i) => i + 1);
        let gameMode = 'color';
        let codeLength = 4;
        let colorCount = 6;
        let allowDuplicates = false;
        let secretCode = [];
        let currentGuess = [];
        let attempts = 0;
        let score = 0;
        let gameStartedAt = null;
        let gameTime = 0;
        let timerInterval = null;
        let isPaused = false;
        let history = [];
        let userProfile = null;
        let winStreak = 0;
        let activeGuessIndex = 0;
        let chatHistory = [];
        
        // DOM elements
        const authModal = document.getElementById('auth-modal');
        const usernameInput = document.getElementById('username-input');
        const passwordInput = document.getElementById('password-input');
        const authMessage = document.getElementById('auth-message');
        const startScreenModal = document.getElementById('start-screen-modal');
        const gameContainer = document.getElementById('game-container');
        const additionalContentContainer = document.getElementById('additional-content-container');
        const guessHistoryDiv = document.getElementById('guess-history');
        const currentGuessRow = document.getElementById('current-guess-row');
        const selectorsContainer = document.getElementById('selectors-container');
        const modeToggle = document.getElementById('mode-toggle');
        const colorCountInput = document.getElementById('color-count');
        const codeLengthInput = document.getElementById('code-length');
        const allowDuplicatesCheckbox = document.getElementById('allow-duplicates');
        const hintBox = document.getElementById('hint-box');
        const attemptsCountDisplay = document.getElementById('attempts-count');
        const scoreDisplay = document.getElementById('score');
        const gameTimeDisplay = document.getElementById('game-time');
        const playerNameDisplay = document.getElementById('player-name-display');
        const playerJoinDateDisplay = document.getElementById('player-join-date');
        const playerLevelDisplay = document.getElementById('player-level-display');
        const playerXpDisplay = document.getElementById('player-xp-display');
        const titleDisplay = document.getElementById('title-display');
        const gameModal = document.getElementById('game-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalContent = document.getElementById('modal-content');
        const finalStatsDisplay = document.getElementById('final-stats');
        const analysisText = document.getElementById('analysis-text');
        const saveStatusDisplay = document.getElementById('save-status');
        const contentDisplay = document.getElementById('content-display');
        const loadGameButton = document.getElementById('load-game-button');
        const chatButton = document.getElementById('chat-button');
        const chatTab = document.getElementById('chat-tab');
        const pauseButton = document.getElementById('pause-button');
        const resumeButton = document.getElementById('resume-button');
        const pauseOverlay = document.getElementById('pause-overlay');

        // Sound settings
        const synth = new Tone.Synth().toDestination();
        const correctSynth = new Tone.PolySynth().toDestination();
        let sfxEnabled = true;

        function playWinSound() { if (sfxEnabled) correctSynth.triggerAttackRelease(["C4", "E4", "G4"], "8n"); }
        function playLoseSound() { if (sfxEnabled) synth.triggerAttackRelease(["C3", "G2"], "8n"); }
        function playCheckSound() { if (sfxEnabled) synth.triggerAttackRelease("C5", "32n"); }
        function playSfx(freq) { if (sfxEnabled) synth.triggerAttackRelease(freq, "32n"); }

        // --- Local "Database" and User Management ---
        function getUsers() { return JSON.parse(localStorage.getItem('gameUsers')) || {}; }
        function saveUsers(users) { localStorage.setItem('gameUsers', JSON.stringify(users)); }
        function saveCurrentUser() { localStorage.setItem('currentUser', JSON.stringify(userProfile)); }
        function loadCurrentUser() { return JSON.parse(localStorage.getItem('currentUser')); }

        function registerUser(username, password) {
            const users = getUsers();
            if (users[username]) {
                authMessage.textContent = '이미 존재하는 사용자 이름입니다.';
                return false;
            }
            users[username] = {
                password,
                xp: 0,
                level: 1,
                title: "새내기",
                joinDate: new Date().toISOString(),
                records: [],
                highestScore: 0,
                shortestTime: null,
                fewestAttempts: null
            };
            saveUsers(users);
            authMessage.textContent = '회원가입 성공! 로그인하세요.';
            return true;
        }

        function loginUser(username, password) {
            const users = getUsers();
            const user = users[username];
            if (user && user.password === password) {
                userProfile = user;
                userProfile.username = username;
                saveCurrentUser();
                authMessage.textContent = '';
                authModal.classList.remove('open');
                startScreenModal.classList.add('open');
                updatePlayerInfoUI();
                return true;
            }
            authMessage.textContent = '로그인 실패: 사용자 이름 또는 비밀번호가 올바르지 않습니다.';
            return false;
        }

        function updatePlayerInfoUI() {
            if (userProfile) {
                playerNameDisplay.textContent = userProfile.username;
                playerLevelDisplay.textContent = userProfile.level;
                playerXpDisplay.textContent = userProfile.xp;
                playerJoinDateDisplay.textContent = new Date(userProfile.joinDate).toLocaleDateString();
                titleDisplay.textContent = getTitle(userProfile.xp);
            }
        }

        function getTitle(xp) {
            if (xp < 1000) return "초보자";
            if (xp < 3000) return "노력가";
            if (xp < 7000) return "도전자";
            if (xp < 15000) return "전문가";
            if (xp < 30000) return "마스터";
            return "전설의 코드 파인더";
        }
        
        // --- Game Logic ---

        // 게임 상태를 로컬 스토리지에 저장하는 함수
        function saveGameState() {
            const gameState = {
                attempts,
                score,
                history,
                secretCode,
                gameMode,
                codeLength,
                colorCount,
                allowDuplicates: allowDuplicatesCheckbox.checked,
                gameStartedAt: gameStartedAt ? gameStartedAt.getTime() : null,
                gameTime,
            };
            localStorage.setItem('mastermindGameState', JSON.stringify(gameState));
            saveStatusDisplay.textContent = '게임이 저장되었습니다!';
            setTimeout(() => {
                saveStatusDisplay.textContent = '';
            }, 3000);
        }

        // 로컬 스토리지에서 게임 상태를 불러오는 함수
        function loadGameState() {
            const savedState = JSON.parse(localStorage.getItem('mastermindGameState'));
            if (!savedState) {
                const messageBox = document.createElement('div');
                messageBox.textContent = '저장된 게임이 없습니다.';
                messageBox.style.cssText = `
                    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
                    background-color: #f97316; color: white; padding: 10px 20px;
                    border-radius: 8px; z-index: 1000; animation: fadeOut 3s forwards;
                `;
                document.body.appendChild(messageBox);
                setTimeout(() => messageBox.remove(), 3000);
                return;
            }

            attempts = savedState.attempts;
            score = savedState.score;
            history = savedState.history;
            secretCode = savedState.secretCode;
            gameMode = savedState.gameMode;
            codeLength = savedState.codeLength;
            colorCount = savedState.colorCount;
            allowDuplicatesCheckbox.checked = savedState.allowDuplicates;
            gameStartedAt = savedState.gameStartedAt ? new Date(savedState.gameStartedAt) : null;
            gameTime = savedState.gameTime;

            startScreenModal.classList.remove('open');
            gameContainer.classList.remove('hidden');
            additionalContentContainer.classList.add('hidden');
            updateGameSettingsFromState();
            renderGuessHistory();
            renderSelectors();
            renderCurrentGuessRow();
            updateGameInfoUI();
            pauseButton.classList.remove('hidden');
            resumeButton.classList.add('hidden');
            startTimer();
        }

        function updateGameSettingsFromState() {
            colorCountInput.value = colorCount;
            codeLengthInput.value = codeLength;
            modeToggle.textContent = gameMode === 'color' ? '색상 모드' : '숫자 모드';
        }

        function updateGameInfoUI() {
            attemptsCountDisplay.textContent = attempts;
            scoreDisplay.textContent = score;
            gameTimeDisplay.textContent = gameTime;
        }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            const startTime = new Date().getTime() - gameTime * 1000;
            timerInterval = setInterval(() => {
                if (!isPaused) {
                    gameTime = Math.floor((new Date().getTime() - startTime) / 1000);
                    gameTimeDisplay.textContent = gameTime;
                }
            }, 1000);
        }
        
        function pauseGame() {
            isPaused = true;
            clearInterval(timerInterval);
            pauseOverlay.classList.remove('hidden');
            document.getElementById('check-button').disabled = true;
            document.getElementById('hint-button').disabled = true;
            document.getElementById('suggest-guess-button').disabled = true;
            pauseButton.classList.add('hidden');
            resumeButton.classList.remove('hidden');
        }
        
        function resumeGame() {
            isPaused = false;
            pauseOverlay.classList.add('hidden');
            document.getElementById('check-button').disabled = false;
            document.getElementById('hint-button').disabled = false;
            document.getElementById('suggest-guess-button').disabled = false;
            pauseButton.classList.remove('hidden');
            resumeButton.classList.add('hidden');
            startTimer();
        }


        function renderGuessHistory() {
            guessHistoryDiv.innerHTML = '';
            history.forEach(item => {
                const historyItem = createHistoryItem(item.guess, item.hits, item.blows, item.misses);
                guessHistoryDiv.prepend(historyItem);
            });
        }
        
        function generateSecretCode() {
            secretCode = [];
            const palette = gameMode === 'color' ? COLORS.slice(0, colorCount) : NUMBERS.slice(0, colorCount);
            if (allowDuplicatesCheckbox.checked) {
                for (let i = 0; i < codeLength; i++) {
                    const randomIndex = Math.floor(Math.random() * palette.length);
                    secretCode.push(palette[randomIndex]);
                }
            } else {
                const shuffledPalette = [...palette].sort(() => 0.5 - Math.random());
                secretCode = shuffledPalette.slice(0, codeLength);
            }
        }

        function checkGuess() {
            if (isPaused) return;

            playCheckSound();
            if (currentGuess.includes(null) || currentGuess.length !== codeLength) {
                const message = '모든 칸을 채워주세요!';
                const messageBox = document.createElement('div');
                messageBox.textContent = message;
                messageBox.style.cssText = `
                    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
                    background-color: #f97316; color: white; padding: 10px 20px;
                    border-radius: 8px; z-index: 1000; animation: fadeOut 3s forwards;
                `;
                document.body.appendChild(messageBox);
                setTimeout(() => messageBox.remove(), 3000);
                return;
            }

            attempts++;
            let hits = 0;
            let blows = 0;
            let tempSecret = [...secretCode];
            let tempGuess = [...currentGuess];

            // 1. Hit (position and value match)
            for (let i = 0; i < codeLength; i++) {
                if (tempGuess[i] !== null && tempGuess[i] === tempSecret[i]) {
                    hits++;
                    tempSecret[i] = null;
                    tempGuess[i] = null;
                }
            }

            // 2. Blow (correct value, wrong position)
            for (let i = 0; i < codeLength; i++) {
                if (tempGuess[i] !== null) {
                    const secretIndex = tempSecret.indexOf(tempGuess[i]);
                    if (secretIndex !== -1) {
                        blows++;
                        tempSecret[secretIndex] = null;
                    }
                }
            }
            
            const misses = codeLength - hits - blows;
            score = (hits * 100) + (blows * 50);

            const historyItem = createHistoryItem(currentGuess, hits, blows, misses);
            guessHistoryDiv.prepend(historyItem);
            history.push({ guess: [...currentGuess], hits, blows, misses });
            saveGameState();

            if (hits === codeLength) {
                endGame(true);
            } else if (attempts >= 10) {
                endGame(false);
            }
            
            renderCurrentGuessRow();
            updateGameInfoUI();
        }

        function endGame(isWin) {
            clearInterval(timerInterval);
            
            if (isWin) {
                playWinSound();
                gameContainer.classList.add('win-glow');
                score += 500 + (1000 / attempts);
                winStreak++;
                modalTitle.textContent = "승리! SUNK!";
                modalContent.textContent = `비밀 코드는 ${secretCode.join(', ')}였습니다!`;
            } else {
                playLoseSound();
                gameContainer.classList.add('lose-shake');
                winStreak = 0;
                modalTitle.textContent = "패배..";
                modalContent.textContent = `비밀 코드는 ${secretCode.join(', ')}였습니다.`;
            }

            finalStatsDisplay.innerHTML = `시도 횟수: ${attempts}<br>총 점수: ${score}<br>게임 시간: ${gameTime}초`;
            
            updateXP(isWin, gameTime);
            saveRecord(isWin, gameTime);
            updatePlayerInfoUI();

            gameModal.classList.add('open');
            localStorage.removeItem('mastermindGameState');
        }

        function updateXP(isWin, gameTime) {
            const difficultyMultiplier = (codeLength * colorCount);
            const baseXP = isWin ? 500 * difficultyMultiplier : 100 * difficultyMultiplier;
            const attemptsBonus = isWin ? Math.max(0, 500 - (attempts * 20)) : 0;
            const timeBonus = Math.max(0, 200 - Math.floor(gameTime / 5));
            const totalXP = baseXP + attemptsBonus + timeBonus;

            if (userProfile) {
                userProfile.xp += totalXP;
                if (userProfile.xp >= userProfile.level * 1000) {
                    userProfile.xp = 0;
                    userProfile.level++;
                }
                const users = getUsers();
                users[userProfile.username] = userProfile;
                saveUsers(users);
                saveCurrentUser();
            }
        }

        function saveRecord(isWin, gameTime) {
            if (!userProfile) return;
            const record = {
                date: new Date().toISOString(),
                win: isWin,
                attempts,
                score,
                time: gameTime,
                winStreak,
                mode: gameMode,
                codeLength,
                colorCount,
                allowDuplicates: allowDuplicatesCheckbox.checked,
                rank: getRankByScore(score),
                difficulty: getDifficultyRank()
            };
            userProfile.records.push(record);

            if (record.score > userProfile.highestScore) {
                userProfile.highestScore = record.score;
            }
            if (record.time < userProfile.shortestTime || userProfile.shortestTime === null) {
                userProfile.shortestTime = record.time;
            }
            if (record.attempts < userProfile.fewestAttempts || userProfile.fewestAttempts === null) {
                userProfile.fewestAttempts = record.attempts;
            }

            const users = getUsers();
            users[userProfile.username] = userProfile;
            saveUsers(users);
            saveCurrentUser();
        }
        
        function getRankByScore(score) {
            if (score >= 2000) return 'S+';
            if (score >= 1500) return 'S';
            if (score >= 1000) return 'A';
            if (score >= 700) return 'B';
            return 'C';
        }

        function getDifficultyRank() {
            const complexity = codeLength * colorCount * (allowDuplicates ? 0.8 : 1.2);
            if (complexity > 40) return 'Expert';
            if (complexity > 20) return 'Hard';
            return 'Normal';
        }

        // --- UI/UX ---
        
        function initGame(isLoad = false) {
            startScreenModal.classList.remove('open');
            gameContainer.classList.remove('hidden');
            additionalContentContainer.classList.add('hidden');
            
            if (!isLoad) {
                startGame();
            }
        }

        function startGame() {
            gameModal.classList.remove('open');
            gameContainer.classList.remove('win-glow', 'lose-shake');
            
            attempts = 0;
            score = 0;
            gameTime = 0;
            history = [];
            guessHistoryDiv.innerHTML = '';
            
            updateGameSettings();
            generateSecretCode();
            renderCurrentGuessRow();
            renderSelectors();
            gameStartedAt = new Date();
            isPaused = false;
            pauseOverlay.classList.add('hidden');
            document.getElementById('check-button').disabled = false;
            document.getElementById('hint-button').disabled = false;
            document.getElementById('suggest-guess-button').disabled = false;
            pauseButton.classList.remove('hidden');
            resumeButton.classList.add('hidden');
            startTimer();
        }

        function updateGameSettings() {
            colorCount = parseInt(colorCountInput.value, 10) || 6;
            codeLength = parseInt(codeLengthInput.value, 10) || 4;

            if (colorCount < 1) colorCount = 1;
            if (colorCount > 16) colorCount = 16;
            if (codeLength < 1) codeLength = 1;
            if (codeLength > 16) codeLength = 16;
            
            if (gameMode === 'color') {
                modeToggle.textContent = '색상 모드';
            } else {
                modeToggle.textContent = '숫자 모드';
            }
        }

        function renderCurrentGuessRow() {
            currentGuessRow.innerHTML = '';
            currentGuess = Array(codeLength).fill(null);
            activeGuessIndex = 0;
            for (let i = 0; i < codeLength; i++) {
                const cell = document.createElement('div');
                cell.className = 'color-cell number-cell current-guess-cell';
                cell.style.backgroundColor = '#6b7280';
                cell.textContent = '?';
                cell.dataset.index = i;
                if (i === activeGuessIndex) {
                    cell.classList.add('active');
                }
                cell.onclick = (e) => {
                    if (isPaused) return;
                    document.querySelectorAll('.current-guess-cell').forEach(c => c.classList.remove('active'));
                    e.target.classList.add('active');
                    activeGuessIndex = parseInt(e.target.dataset.index);
                };
                currentGuessRow.appendChild(cell);
            }
        }

        function renderSelectors() {
            selectorsContainer.innerHTML = '';
            const palette = gameMode === 'color' ? COLORS.slice(0, colorCount) : NUMBERS.slice(0, colorCount);
            palette.forEach((val) => {
                const cell = document.createElement('div');
                cell.className = 'selector-cell cursor-pointer';
                if (gameMode === 'color') {
                    cell.style.backgroundColor = val;
                } else {
                    cell.textContent = val;
                    cell.style.backgroundColor = '#374151';
                }
                cell.onclick = () => {
                    if (isPaused) return;
                    if (activeGuessIndex !== -1 && activeGuessIndex < codeLength) {
                        currentGuess[activeGuessIndex] = val;
                        const guessCell = currentGuessRow.children[activeGuessIndex];
                        if (gameMode === 'color') {
                            guessCell.style.backgroundColor = val;
                            guessCell.textContent = '';
                        } else {
                            guessCell.textContent = val;
                            guessCell.style.backgroundColor = '#374151';
                        }
                        
                        // Automatically move to the next empty cell
                        let nextIndex = activeGuessIndex + 1;
                        while(nextIndex < codeLength && currentGuess[nextIndex] !== null) {
                            nextIndex++;
                        }
                        if (nextIndex < codeLength) {
                            activeGuessIndex = nextIndex;
                            document.querySelectorAll('.current-guess-cell').forEach(c => c.classList.remove('active'));
                            currentGuessRow.children[activeGuessIndex].classList.add('active');
                        } else {
                            activeGuessIndex = -1; // No more empty cells
                            document.querySelectorAll('.current-guess-cell').forEach(c => c.classList.remove('active'));
                        }
                    }
                };
                selectorsContainer.appendChild(cell);
            });
        }

        function createHistoryItem(guess, hits, blows, misses) {
            const item = document.createElement('div');
            item.className = 'flex items-center justify-between p-3 rounded-xl mb-2 bg-gray-800 transition-colors duration-300';
            
            const guessRow = document.createElement('div');
            guessRow.className = 'flex gap-2';
            guess.forEach(val => {
                const cell = document.createElement('div');
                cell.className = 'color-cell cursor-not-allowed';
                if (gameMode === 'color') {
                    cell.style.backgroundColor = val;
                    cell.textContent = '';
                } else {
                    cell.textContent = val;
                    cell.style.backgroundColor = '#374151';
                }
                guessRow.appendChild(cell);
            });
            
            const feedbackRow = document.createElement('div');
            feedbackRow.className = 'flex gap-1';
            for (let i = 0; i < hits; i++) {
                const peg = document.createElement('div');
                peg.className = 'feedback-peg hit';
                feedbackRow.appendChild(peg);
            }
            for (let i = 0; i < blows; i++) {
                const peg = document.createElement('div');
                peg.className = 'feedback-peg blow';
                feedbackRow.appendChild(peg);
            }
            for (let i = 0; i < misses; i++) {
                const peg = document.createElement('div');
                peg.className = 'feedback-peg miss';
                feedbackRow.appendChild(peg);
            }
            
            item.appendChild(guessRow);
            item.appendChild(feedbackRow);
            return item;
        }

